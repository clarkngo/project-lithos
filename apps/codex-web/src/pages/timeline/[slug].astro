---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocArticle from "../../components/DocArticle.astro";
import { loadCollection, loadPage, type DocPage } from "../../lib/docs";
import { docPlate } from "../../lib/art";

export function getStaticPaths() {
  return loadCollection("timeline").map((page: DocPage) => ({ params: { slug: page.slug } }));
}

const { slug } = Astro.params;
const page = loadPage("timeline", slug!);
if (!page) {
  throw new Error(`Missing timeline page: ${slug}`);
}
const plate = docPlate("timeline", page.slug);
---

<BaseLayout title={page.title} description={page.description} image={plate?.src}>
  <DocArticle page={page} plate={plate} />
</BaseLayout>
