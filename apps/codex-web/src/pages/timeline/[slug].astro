---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocArticle from "../../components/DocArticle.astro";
import { loadCollection, loadPage, type DocPage } from "../../lib/docs";

export function getStaticPaths() {
  return loadCollection("timeline").map((page: DocPage) => ({ params: { slug: page.slug } }));
}

const { slug } = Astro.params;
const page = loadPage("timeline", slug!);
if (!page) {
  throw new Error(`Missing timeline page: ${slug}`);
}
---

<BaseLayout title={page.title} description={page.description}>
  <DocArticle page={page} />
</BaseLayout>
