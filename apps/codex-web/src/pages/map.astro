---
import BaseLayout from "../layouts/BaseLayout.astro";
import MapViewer from "../components/MapViewer.astro";
import ArtFrame from "../components/ArtFrame.astro";
import { worldPlates } from "../lib/art";
---

<BaseLayout title="Map" description="Placeholder survey of mine country, Hollow Cut, the Glass Wastes, and the Vault.">
  <header class="max-w-2xl space-y-3 mb-8">
    <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-brass-dim">Survey unfinished</p>
    <h1 class="font-serif text-4xl text-paper">Map</h1>
    <p class="text-muted leading-relaxed">
      A static placeholder diagram, then the painted plates: mine country, Hollow Cut, the Glass Wastes, the Vault.
      Distances, borders, and the Spire's polity are unconfirmed.
    </p>
  </header>
  <MapViewer />
  {worldPlates.length > 0 && (
    <section class="mt-12 space-y-4">
      <h2 class="font-serif text-2xl text-paper">Places</h2>
      <ul class="grid gap-4 sm:grid-cols-2">
        {worldPlates.map((plate) => (
          <li>
            <ArtFrame plate={plate} />
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
