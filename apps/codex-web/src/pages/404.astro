---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/paths";
---

<BaseLayout title="Not found">
  <section class="max-w-xl space-y-4">
    <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-brass-dim">404</p>
    <h1 class="font-serif text-4xl text-paper">This seam was never charted.</h1>
    <p class="text-muted">The page is not in the Codex. It may not have been confirmed against the manuscript yet.</p>
    <p><a href={withBase()}>Return to the Field Codex</a></p>
  </section>
</BaseLayout>
