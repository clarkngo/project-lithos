---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CollectionIndex from "../../components/CollectionIndex.astro";
import { loadCollection } from "../../lib/docs";
import { thumbsFor } from "../../lib/art";

const pages = loadCollection("factions");
---

<BaseLayout title="Factions" description="Mining Guild, Warden Enforcers, and the Synod.">
  <CollectionIndex
    title="Factions"
    lede="Three later answers to the same crime. Extraction, enforcement, doctrine — none of them undo the Culling."
    pages={pages}
    basePath="factions"
    thumbs={thumbsFor("factions", pages.map((page) => page.slug))}
  />
</BaseLayout>
