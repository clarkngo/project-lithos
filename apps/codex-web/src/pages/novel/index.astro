---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/paths";
import { listBooks } from "../../lib/novel";
import { keyArt } from "../../lib/art";

const books = listBooks();
---

<BaseLayout title="The novel" description="Read The Last Lithoi as it stands in /novel." image={keyArt?.src}>
  <header class="max-w-2xl space-y-3 mb-10">
    <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-brass-dim">Manuscript</p>
    <h1 class="font-serif text-4xl text-paper">The Last Lithoi</h1>
    <p class="text-muted leading-relaxed">
      Chapters are rendered from <code>/novel</code> at build time. The manuscript is the source of truth; the Codex
      bible follows it, not the other way around.
    </p>
    <p class="flex flex-wrap gap-3">
      <a href={withBase("manuscript/the-last-lithoi-book-1.epub")} class="px-4 py-2 bg-brass text-ink no-underline font-medium hover:bg-amber">Download Book One EPUB</a>
      <a href={withBase("manuscript/the-last-lithoi-book-1.pdf")} class="px-4 py-2 border border-rule text-paper no-underline hover:border-brass">Download Book One PDF</a>
    </p>
  </header>

  <ul class="grid gap-4 sm:grid-cols-2">
    {books.map((book) => (
      <li>
        <a href={withBase(`novel/${book.slug}/`)} class="slot-card p-5 block no-underline hover:border-brass/60 h-full">
          <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-brass">
            {book.pieces.filter((piece) => piece.kind === "chapter").length} chapters
          </p>
          <h2 class="font-serif text-2xl text-paper mt-2">{book.title}</h2>
          {book.subtitle && <p class="mt-1 text-brass">{book.subtitle}</p>}
          <p class="mt-3 text-sm text-muted">Start: {book.start.title}</p>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
