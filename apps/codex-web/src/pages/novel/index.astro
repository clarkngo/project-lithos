---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/paths";
import { listBooks } from "../../lib/novel";
import { bookCover, keyArt } from "../../lib/art";

const books = listBooks();
const og = bookCover(1) ?? keyArt;
---

<BaseLayout title="The novel" description="Read The Last Lithoi as it stands in /novel." image={og?.src}>
  <header class="max-w-2xl space-y-3 mb-10">
    <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-brass-dim">Manuscript</p>
    <h1 class="font-serif text-4xl text-paper">The Last Lithoi</h1>
    <p class="text-lg text-brass">by Clark Ngo</p>
    <p class="text-muted leading-relaxed">
      Chapters are rendered from <code>/novel</code> at build time. The manuscript is the source of truth; the Codex
      bible follows it, not the other way around. Open a volume below to read in the browser.
    </p>
  </header>

  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {books.map((book) => {
      const cover = bookCover(book.number);
      return (
        <li>
          <a href={withBase(`novel/${book.slug}/`)} class="slot-card overflow-hidden block no-underline hover:border-brass/60 h-full">
            {cover && (
              <img src={cover.src} alt="" class="w-full aspect-[3/4] object-cover object-top bg-ink" />
            )}
            <div class="p-5">
              <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-brass">
                {book.pieces.filter((piece) => piece.kind === "chapter").length} chapters · read online
              </p>
              <h2 class="font-serif text-2xl text-paper mt-2">{book.title}</h2>
              {book.subtitle && <p class="mt-1 text-brass">{book.subtitle}</p>}
              <p class="mt-3 text-sm text-muted">Start: {book.start.title}</p>
            </div>
          </a>
        </li>
      );
    })}
  </ul>

  <aside class="mt-12 max-w-2xl space-y-3 text-sm text-muted">
    <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-brass">Optional downloads</p>
    <p>EPUB and PDF builds are available if you want a file copy. Reading in the Codex is the default.</p>
    <p class="flex flex-wrap gap-x-4 gap-y-2">
      {books.flatMap((book) => [
        <a href={withBase(`manuscript/the-last-lithoi-book-${book.number}.epub`)}>Book {book.number} EPUB</a>,
        <a href={withBase(`manuscript/the-last-lithoi-book-${book.number}.pdf`)}>Book {book.number} PDF</a>,
      ])}
    </p>
  </aside>
</BaseLayout>
