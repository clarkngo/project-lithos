---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { withBase } from "../../../lib/paths";
import { groupByAct, listBooks, loadBook, type NovelBook } from "../../../lib/novel";
import { keyArt } from "../../../lib/art";

export function getStaticPaths() {
  return listBooks().map((book: NovelBook) => ({ params: { book: book.slug } }));
}

const book = loadBook(Astro.params.book!);
if (!book) {
  throw new Error(`Missing novel book: ${Astro.params.book}`);
}
const groups = groupByAct(book);
const pageTitle = book.subtitle ? `${book.title}: ${book.subtitle}` : book.title;
---

<BaseLayout title={pageTitle} description={`Read ${pageTitle}.`} image={keyArt?.src}>
  <header class="max-w-2xl space-y-3 mb-10">
    <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-brass-dim">
      <a href={withBase("novel/")} class="no-underline hover:text-amber">Manuscript</a>
    </p>
    <h1 class="font-serif text-4xl text-paper">{book.title}</h1>
    {book.subtitle && <p class="text-lg text-brass">{book.subtitle}</p>}
    <p>
      <a href={withBase(`novel/${book.start.path}/`)} class="px-4 py-2 bg-brass text-ink no-underline font-medium hover:bg-amber inline-block">
        Start reading
      </a>
    </p>
  </header>

  <div class="grid gap-10 lg:grid-cols-2">
    {groups.map((group) => (
      <section>
        <h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-brass mb-3">{group.label}</h2>
        <ol class="slot-card divide-y divide-rule/60">
          {group.pieces.map((piece) => (
            <li>
              <a href={withBase(`novel/${piece.path}/`)} class="block no-underline hover:bg-raised">
                {piece.plateSrc && (
                  <img src={piece.plateSrc} alt="" class="w-full h-28 object-cover object-center bg-ink" />
                )}
                <span class="block px-4 py-3 text-paper">{piece.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</BaseLayout>
