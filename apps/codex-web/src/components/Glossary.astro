---
import type { GlossaryTerm } from "../lib/docs";

type Props = {
  terms: GlossaryTerm[];
};

const { terms } = Astro.props;
const byLetter = new Map<string, GlossaryTerm[]>();

for (const term of terms) {
  const letter = term.term.charAt(0).toUpperCase();
  const list = byLetter.get(letter) ?? [];
  list.push(term);
  byLetter.set(letter, list);
}

const letters = [...byLetter.keys()].sort();
---

<div class="space-y-8" data-glossary>
  <div class="relative max-w-xl">
    <label class="font-mono text-[11px] uppercase tracking-[0.18em] text-brass" for="glossary-filter">Filter</label>
    <input
      id="glossary-filter"
      type="search"
      placeholder="Lithoi, Drift, Vault…"
      class="mt-2 w-full bg-ink border border-rule text-paper px-3 py-2"
      data-glossary-filter
    />
  </div>

  {letters.map((letter) => (
    <section data-letter-group>
      <h2 class="font-serif text-2xl text-brass mb-4">{letter}</h2>
      <dl class="space-y-5">
        {(byLetter.get(letter) ?? []).map((term) => (
          <div class="slot-card p-4 sm:p-5" data-term data-term-text={`${term.term} ${term.definition}`.toLowerCase()} id={term.id}>
            <dt class="font-serif text-xl text-paper">{term.term}</dt>
            <dd class="mt-2 text-paper/85 leading-relaxed">{term.definition}</dd>
            {term.seeAlso && term.seeAlso.length > 0 && (
              <p class="mt-3 text-sm text-muted">
                See also:
                {term.seeAlso.map((id, index) => (
                  <>
                    {index > 0 && ", "}
                    <a href={`#${id}`}>{id.replace(/-/g, " ")}</a>
                  </>
                ))}
              </p>
            )}
          </div>
        ))}
      </dl>
    </section>
  ))}
</div>

<script>
  const root = document.querySelector("[data-glossary]");
  const input = root?.querySelector<HTMLInputElement>("[data-glossary-filter]");
  if (root && input) {
    const cards = [...root.querySelectorAll<HTMLElement>("[data-term]")];
    const groups = [...root.querySelectorAll<HTMLElement>("[data-letter-group]")];

    input.addEventListener("input", () => {
      const query = input.value.trim().toLowerCase();
      for (const card of cards) {
        const haystack = card.dataset.termText ?? "";
        card.hidden = query.length > 0 && !haystack.includes(query);
      }
      for (const group of groups) {
        const visible = [...group.querySelectorAll<HTMLElement>("[data-term]")].some((card) => !card.hidden);
        group.hidden = !visible;
      }
    });
  }
</script>
