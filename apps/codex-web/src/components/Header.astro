---
import { withBase } from "../lib/paths";

const here = Astro.url.pathname;

const links = [
  { href: withBase(), label: "Codex" },
  { href: withBase("characters/"), label: "Cast" },
  { href: withBase("factions/"), label: "Factions" },
  { href: withBase("magic-system/"), label: "Resonance" },
  { href: withBase("timeline/"), label: "Timeline" },
  { href: withBase("calculator/"), label: "Inscription" },
  { href: withBase("glossary/"), label: "Glossary" },
  { href: withBase("map/"), label: "Map" },
];

function isActive(href: string): boolean {
  if (href === withBase()) {
    const stripped = here.replace(/\/+$/, "") || "/";
    const home = withBase().replace(/\/+$/, "") || "/";
    return stripped === home;
  }
  return here.startsWith(href) || here.startsWith(href.replace(/\/+$/, ""));
}
---

<header class="border-b border-rule/80 bg-ink/80 backdrop-blur sticky top-0 z-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
    <a href={withBase()} class="no-underline group">
      <p class="font-mono text-[11px] tracking-[0.22em] uppercase text-brass-dim group-hover:text-amber">Project Lithos</p>
      <p class="font-serif text-xl text-paper leading-tight">The Last Lithoi</p>
    </a>
    <nav class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "no-underline tracking-wide",
            isActive(link.href) ? "text-amber" : "text-muted hover:text-paper",
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
