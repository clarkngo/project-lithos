---
import { withBase } from "../lib/paths";
---

<div class="space-y-4">
  <div class="flex flex-wrap items-center gap-2 text-sm">
    <button type="button" class="px-3 py-1.5 border border-rule text-brass hover:text-amber" data-zoom-out>−</button>
    <button type="button" class="px-3 py-1.5 border border-rule text-brass hover:text-amber" data-zoom-in>+</button>
    <button type="button" class="px-3 py-1.5 border border-rule text-muted hover:text-paper" data-zoom-reset>Reset</button>
    <p class="text-muted ml-1">Scroll to zoom. Drag to pan. Tiles and real cartography come later.</p>
  </div>

  <div
    class="relative overflow-hidden border border-rule bg-ink h-[min(70vh,640px)] cursor-grab active:cursor-grabbing"
    data-map-frame
  >
    <div class="absolute inset-0 origin-center" data-map-stage>
      <img
        src={withBase("map-placeholder.svg")}
        alt="Placeholder survey of the mine country, Hollow Cut, the Glass Wastes, the Vault, and the Spire."
        class="w-full h-full object-contain select-none pointer-events-none"
        draggable="false"
      />
    </div>
  </div>
</div>

<script>
  const frame = document.querySelector<HTMLElement>("[data-map-frame]");
  const stage = document.querySelector<HTMLElement>("[data-map-stage]");
  if (frame && stage) {
    let scale = 1;
    let x = 0;
    let y = 0;
    let dragging = false;
    let lastX = 0;
    let lastY = 0;

    const paint = () => {
      stage.style.transform = `translate(${x}px, ${y}px) scale(${scale})`;
    };

    const clampScale = (value: number) => Math.min(4, Math.max(0.6, value));

    frame.addEventListener(
      "wheel",
      (event) => {
        event.preventDefault();
        const delta = event.deltaY > 0 ? 0.9 : 1.1;
        scale = clampScale(scale * delta);
        paint();
      },
      { passive: false },
    );

    frame.addEventListener("pointerdown", (event) => {
      dragging = true;
      lastX = event.clientX;
      lastY = event.clientY;
      frame.setPointerCapture(event.pointerId);
    });

    frame.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      x += event.clientX - lastX;
      y += event.clientY - lastY;
      lastX = event.clientX;
      lastY = event.clientY;
      paint();
    });

    const stop = () => {
      dragging = false;
    };
    frame.addEventListener("pointerup", stop);
    frame.addEventListener("pointercancel", stop);

    document.querySelector("[data-zoom-in]")?.addEventListener("click", () => {
      scale = clampScale(scale * 1.2);
      paint();
    });
    document.querySelector("[data-zoom-out]")?.addEventListener("click", () => {
      scale = clampScale(scale / 1.2);
      paint();
    });
    document.querySelector("[data-zoom-reset]")?.addEventListener("click", () => {
      scale = 1;
      x = 0;
      y = 0;
      paint();
    });
  }
</script>
